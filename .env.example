# ----------------------------------------------------------------------------
# Environment variables for the Abhinav Bharata portfolio.
# Copy to `.env.local` and fill in. Only NEXT_PUBLIC_* values are exposed to
# the browser; never put secrets here without the appropriate prefix.
# ----------------------------------------------------------------------------

# Canonical production origin (no trailing slash). Used for metadataBase,
# sitemap, robots, and canonical URLs.
NEXT_PUBLIC_SITE_URL=https://abhinav-bharata.example.com

# Public profiles. Leave blank to hide the corresponding icon/button gracefully.
NEXT_PUBLIC_LINKEDIN_URL=
NEXT_PUBLIC_GITHUB_URL=

# cfd-agent links (repository + demo video). Leave blank if not yet public.
NEXT_PUBLIC_CFD_AGENT_REPOSITORY=
NEXT_PUBLIC_CFD_AGENT_DEMO=

# --- Server-only (contact form). Never exposed to the client. ---

# Resend API key. When unset (or RESEND_FROM unset), the contact form falls back
# to a mailto: link instead of sending server-side.
RESEND_API_KEY=

# Verified Resend sending address, e.g. "Portfolio <mail@yourdomain.com>".
RESEND_FROM=

# Recipient address for contact-form submissions.
CONTACT_EMAIL=bharata.abhinav@gmail.com
